{
  "name": "commit-history",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js dev --port 3000",
    "generate-routes": "tsr generate",
    "og": "tsx scripts/generate-og.ts",
    "build": "tsx scripts/generate-og.ts && vite build && pnpm run build:worker",
    "build:worker": "esbuild scripts/profile-ingestion-worker.ts scripts/profile-ingestion-queue-migrate.ts scripts/enqueue-profile-ingestion.ts --bundle --platform=node --target=node24 --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outdir=.output/worker --out-extension:.js=.mjs",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "check:posts": "bun scripts/check-post-people.ts",
    "suspend": "bun scripts/suspend.ts",
    "refresh": "bun scripts/refresh.ts",
    "refresh-user": "bun scripts/refresh-user.ts",
    "profile:enqueue": "node --env-file-if-exists=.env --import tsx scripts/enqueue-profile-ingestion.ts",
    "profile:queue:migrate": "node --env-file-if-exists=.env --import tsx scripts/profile-ingestion-queue-migrate.ts",
    "profile:worker": "node --env-file-if-exists=.env --import tsx scripts/profile-ingestion-worker.ts",
    "monthly:user": "node --env-file-if-exists=.env --import tsx scripts/monthly-user-refresh.ts",
    "backfill": "bun scripts/backfill-contributions.ts",
    "refresh:orgs": "node --env-file-if-exists=.env --import tsx scripts/refresh-orgs.ts",
    "backup": "bash scripts/backup.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:refresh-dev": "bash scripts/refresh-dev-db.sh",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.168.47",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "pg-boss": "12.28.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "satori": "^0.26.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.45",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "nitro": "3.0.260903-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
